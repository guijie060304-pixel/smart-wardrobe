<view class="preview-frame">
  <canvas type="2d" id="bodyCanvas" class="body-canvas" disable-scroll="{{gestureLocked}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindlongpress="onLongPress" bindtouchend="onTouchEnd" bindtouchcancel="onTouchCancel" />
  <view wx:if="{{gestureHint}}" class="gesture-note">{{gestureHint}}</view>
  <view wx:if="{{loading}}" class="loading-note">正在准备预览…</view>
  <view wx:if="{{renderError}}" class="render-error">
    <view>{{renderError}}</view>
    <button size="mini" bindtap="retry">重新绘制</button>
  </view>
</view>
<view wx:if="{{warnings.length}}" class="image-warnings">
  <view wx:for="{{warnings}}" wx:key="*this">{{item}}</view>
  <button size="mini" bindtap="retry">重新读取图片</button>
</view>
