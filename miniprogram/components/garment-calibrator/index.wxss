.calibration-frame { position: relative; width: 100%; height: 400px; max-height: 57vh; min-height: 280px; border-radius: 22rpx; overflow: hidden; background: #eeede7; }
.calibration-canvas { display: block; width: 100%; height: 100%; }
.calibration-error { position: absolute; inset: 0; padding: 30rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #eeede7; color: #a34543; font-size: 26rpx; text-align: center; }
