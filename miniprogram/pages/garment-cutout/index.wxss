.cutout-page { height: 100vh; box-sizing: border-box; padding: 24rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: #F5F3EE; }
.cutout-heading { font-size: 36rpx; font-weight: 600; color: #28483B; }
.cutout-note { font-size: 23rpx; line-height: 1.55; color: #69776C; margin: 10rpx 0; }
.cutout-error { color: #A34543; font-size: 23rpx; padding: 10rpx; background: #FFF1E9; border-radius: 12rpx; }
.canvas-wrap { flex: 1; min-height: 180rpx; position: relative; margin: 12rpx 0; overflow: hidden; border: 1rpx solid #DCE3D9; border-radius: 20rpx; background: white; }
.cutout-canvas { width: 100%; height: 100%; }
.canvas-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #69776C; background: #FAF9F5; font-size: 26rpx; }
.tool-row { display: flex; gap: 10rpx; margin-top: 10rpx; }
.tool { flex: 1; margin: 0; padding: 0 8rpx; font-size: 24rpx; line-height: 64rpx; background: #FFFEFA; color: #405A48; border-radius: 12rpx; }
.tool.active { background: #28483B; color: white; }
.tool::after { border: none; }
.size-row { display: flex; align-items: center; font-size: 24rpx; color: #526A58; }
.size-row slider { flex: 1; margin: 12rpx 20rpx; }
.secondary-tools .tool { font-size: 23rpx; line-height: 56rpx; }
.footer-actions { display: flex; gap: 16rpx; margin-top: 8rpx; }
.footer-actions button { flex: 1; margin: 0; }
.footer-note { text-align: center; margin-bottom: 0; font-size: 21rpx; }
.hidden-canvas { position: fixed; left: -10000px; top: 0; width: 1px; height: 1px; pointer-events: none; }
