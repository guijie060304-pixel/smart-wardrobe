<view class="page-shell">
  <view class="eyebrow">LOOKBOOK / SAVED</view>
  <view class="page-title">我的穿搭</view>
  <view class="page-subtitle">选衣组合，保存喜欢的日常穿搭</view>
  <view class="outfit-actions"><button id="outfitsFreeMatch" class="primary-button" bindtap="goMatch">＋ 新建自由搭配</button><button id="outfitsCalendar" class="secondary-button" bindtap="goCalendar">穿搭日历</button></view>
  <view class="mode-tabs">
    <button class="{{!deleted ? 'selected' : ''}}" size="mini" data-mode="active" bindtap="setMode">已保存</button>
    <button class="{{deleted ? 'selected' : ''}}" size="mini" data-mode="deleted" bindtap="setMode">回收站</button>
  </view>
  <input class="search-input" value="{{query}}" placeholder="搜索穿搭名称" bindinput="onQueryInput" />
  <view wx:if="{{loadError}}" class="card empty-state error-text"><view>{{loadError}}</view><button size="mini" bindtap="loadOutfits">重新读取</button></view>
  <block wx:else>
    <view wx:if="{{!cards.length}}" class="card empty-state">
      <view class="empty-title">{{query ? '没有符合条件的穿搭' : deleted ? '回收站是空的' : '还没有保存穿搭'}}</view>
      <view class="empty-copy">{{deleted ? '删除的穿搭会保留在这里，可以恢复。' : '点上方“新建自由搭配”，从衣橱选衣并保存。'}}</view>
    </view>
    <view wx:for="{{cards}}" wx:key="id" class="card outfit-card" data-id="{{item.id}}" bindtap="openOutfit">
      <view class="outfit-heading"><view class="outfit-name">{{item.name}}</view><button wx:if="{{!deleted}}" class="card-delete" size="mini" disabled="{{!!deletingId}}" data-id="{{item.id}}" catchtap="deleteCard">删除</button></view>
      <view class="outfit-images"><image wx:for="{{item.images}}" wx:for-item="path" wx:key="*this" src="{{path}}" mode="aspectFit" /></view>
      <view class="card-meta">{{item.kindLabel}} · {{item.count}} 件衣物 · {{deleted ? '删除于' : '更新于'}} {{item.date}}</view>
      <view wx:if="{{item.issueCount}}" class="issue-note">{{item.issueCount}} 件衣物已删除或分类改变，可打开查看</view>
    </view>
  </block>
  <button class="secondary-button action" bindtap="goTryOn">去模特试衣</button>
</view>
